# آدرس پایه بک‌اند (فرانت‌اند به‌صورت خودکار مسیر /api و /uploads را بر اساس این متغیر مدیریت می‌کند)
NEXT_PUBLIC_API_URL=https://backend.radinet24.com

# سازگاری با نسخه‌های قبلی (اختیاری - هم‌مقدار با NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_BACKEND_URL=https://backend.radinet24.com/api
BACKEND_URL=https://backend.radinet24.com/api

# کلید امضای توکن JWT (فقط سمت سرور Next.js برای Middleware و Route Handlerها؛ باید دقیقاً برابر با JWT_SECRET بک‌اند باشد)
JWT_SECRET=CHANGE_ME_TO_STRONG_SHARED_SECRET

# محیط اجرا و پورت داخلی سرویس فرانت‌اند در چابکان
NODE_ENV=production
PORT=3000
